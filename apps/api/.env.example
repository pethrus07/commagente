# PostgreSQL (Prisma) — sobe via docker-compose na fatia 1 (Fundação)
DATABASE_URL="postgresql://zapagente:zapagente@localhost:5432/zapagente?schema=public"

# Evolution API (camada WhatsApp — Fatia 2)
# EVOLUTION_API_KEY deve bater com AUTHENTICATION_API_KEY do docker-compose.
EVOLUTION_URL="http://localhost:8080"
EVOLUTION_API_KEY="zapagente-dev-key"
# URL que a Evolution (no Docker) chama pra entregar os eventos no nosso ingestor.
WEBHOOK_URL="http://host.docker.internal:3000/webhook"

# IA (Fatia 4/4b) — provider-agnostic. IA_PROVIDER: duble (offline) | openai (real)
IA_PROVIDER="duble"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-..."

# Transcrição de áudio (Tier 3) — segue IA_PROVIDER por padrão. openai usa a OPENAI_API_KEY.
# TRANSCRITOR_PROVIDER="openai"   # openai | duble
TRANSCRITOR_MODELO="whisper-1"
TRANSCRITOR_IDIOMA="pt"

# Provider de WhatsApp (seam da "escada" p/ API oficial) — hoje só evolution.
WHATSAPP_PROVIDER="evolution"

# Porta HTTP da API (default 3000)
# PORT="3000"

# Autenticação (Fatia MT-1) — em produção defina um JWT_SECRET forte e único.
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# Super-admin semeado no boot (login inicial do painel).
SUPER_ADMIN_EMAIL="admin@zapagente.local"
SUPER_ADMIN_SENHA="zapagente123"

# App
TZ="America/Sao_Paulo"
