// zapagente — schema de dados (Prisma + PostgreSQL)
// Camada Infraestrutura: expressa o modelo do Domínio em tabelas.
// Convenção: models PascalCase, campos camelCase, colunas/tabelas snake_case via @map/@@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (o que é fechado, o banco valida) ─────────────────
enum EstadoMissao {
  configurada
  na_fila
  em_conversa
  concluida
  descartada
  escalada
  sem_resposta
  arquivada
}

enum Direcao {
  in
  out
}

enum Papel {
  super_admin // dono da plataforma (Pedro) — vê todos os tenants
  admin_tenant // administrador de um tenant (cliente)
  operador // operador do tenant (atende, assume conversas)
}

enum StatusConhecimento {
  sugerido // proposto pela IA — aguarda aprovação humana
  aprovado // vale como conhecimento (a IA consulta)
  rejeitado // descartado
}

enum StatusEnvio {
  pendente
  enviando
  ok
  erro
}

enum StatusConexao {
  desconectado
  conectando
  conectado
}

// ─── Tenancy ─────────────────────────────────────────────────
model Tenant {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String
  // Persona / identidade da IA do tenant (voz da marca): injetada SEMPRE no prompt de
  // toda missão (o `tom` da missão dá nuance/override). Define uma vez → tudo herda.
  persona  String?
  // Estilo de conversa (JSON): controles estruturados (formalidade, emoji, abreviação,
  // travessão, bolhas) que viram regras de escrita no prompt. Ver features/tenant/tenant.estilo.
  estilo   Json?
  // DNA (JSON): conhecimento categorizado da empresa (empresa/produtos/preços/regras/FAQ…).
  // Renomeia a "Voz da Marca" → DNA. Defaults-first (categorias vazias não entram no prompt) +
  // orçamento de contexto (cap por categoria). Ver features/tenant/tenant.dna. [parceiro Item 4]
  dna      Json?
  criadoEm DateTime @default(now()) @map("criado_em")

  numeros   NumeroWhatsapp[]
  contatos  Contato[]
  templates MissaoTemplate[]
  missoes   Missao[]
  mensagens Mensagem[]
  fila         FilaEnvio[]
  eventos      Evento[]
  usuarios     Usuario[]
  conhecimento Conhecimento[]
  campanhas    Campanha[]
  agendamentos Agendamento[]
  tags         Tag[]
  midias       Midia[]

  @@map("tenants")
}

// ─── Biblioteca de mídia: arquivos "bonitos" (catálogo, tabela de preço, PDF) que a IA
// pode ENVIAR ao contato quando fizer sentido (ação enviar_midia). [parceiro §8.15] ──
model Midia {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String // rótulo pra IA reconhecer (ex.: "Catálogo de peças", "Tabela de preços")
  mimetype  String
  tamanho   Int // bytes
  dados     Bytes // o arquivo em si (bytea)
  criadoEm  DateTime @default(now()) @map("criado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("midia")
}

// ─── Memória COLETIVA do tenant (conhecimento curado / aprendido) ──
model Conhecimento {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  titulo    String
  conteudo  String
  status    StatusConhecimento @default(aprovado)
  origem    String             @default("manual") // manual | ia
  // Categoria do DNA a que este documento pertence (empresa/produtos/precos/...); null = base geral.
  // Unifica DNA + Conhecimento numa tela só: cada doc aparece agrupado sob sua categoria. [parceiro]
  categoria String?
  missaoId  String?            @map("missao_id") @db.Uuid // proveniência (de onde a IA aprendeu)
  criadoEm  DateTime           @default(now()) @map("criado_em")

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  chunks ConhecimentoChunk[]

  @@index([tenantId, status])
  @@map("conhecimento")
}

// Pedaços vetorizados do conhecimento (RAG): cada item aprovado é fatiado em trechos
// e cada trecho ganha um embedding. A recuperação por relevância (cosseno em memória)
// injeta só os trechos mais próximos da conversa — corta custo e escala a base.
model ConhecimentoChunk {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conhecimentoId String   @map("conhecimento_id") @db.Uuid
  ordem          Int      @default(0)
  conteudo       String
  embedding      Float[] // vetor do trecho (dims do modelo de embeddings)
  criadoEm       DateTime @default(now()) @map("criado_em")

  conhecimento Conhecimento @relation(fields: [conhecimentoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("conhecimento_chunks")
}

// ─── Usuários (login no painel; super-admin ou por tenant) ───
model Usuario {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid // null = super-admin (sem tenant)
  email     String   @unique
  senhaHash String   @map("senha_hash")
  papel     Papel    @default(operador)
  // Aceite dos termos no 1º login (LGPD/uso de dados + responsabilidade do número).
  // null = ainda não aceitou; timestamp = quando aceitou.
  aceitouTermosEm DateTime? @map("aceitou_termos_em")
  criadoEm  DateTime @default(now()) @map("criado_em")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("usuarios")
}

// ─── Números / chips (estado de aquecimento e budget) ────────
model NumeroWhatsapp {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  telefone           String
  apelido            String? // nome/apelido do número (ex.: "Comercial", "João") — identificação amigável
  instanciaEvolution String        @map("instancia_evolution")
  statusConexao      StatusConexao @default(desconectado) @map("status_conexao")
  aquecimentoEstagio Int           @default(1) @map("aquecimento_estagio")
  budgetDiario       Int           @default(10) @map("budget_diario")
  enviadosHoje       Int           @default(0) @map("enviados_hoje")
  enviadosData       String?       @map("enviados_data") // dia-ref (YYYY-MM-DD no TZ) do contador; muda o dia → zera
  maxConversasAtivas Int           @default(20) @map("max_conversas_ativas") // cap de conversas simultâneas conduzidas pela IA
  proximoEnvioEm     DateTime?     @map("proximo_envio_em") // anti-rajada: só envia de novo a partir daqui
  janelaInicio       String        @default("08:00") @map("janela_inicio") // HH:mm
  janelaFim          String        @default("20:00") @map("janela_fim")
  // Suporte reativo: se ligado, um inbound sem missão ativa abre uma conversa de
  // suporte na hora (cobre "todos os contatos + quem entrar em contato").
  suporteReativo     Boolean       @default(false) @map("suporte_reativo")
  suporteObjetivo    String?       @map("suporte_objetivo")
  suporteTom         String?       @map("suporte_tom")
  suporteInformacoes String?       @map("suporte_informacoes")
  suporteCriterio    String?       @map("suporte_criterio")
  suporteModo        String        @default("auto") @map("suporte_modo")
  // Aviso de escalonamento no WhatsApp: quando uma conversa escala, avisa o operador.
  // Reusa o self-send (validado: o número entrega mensagem pra ele mesmo).
  avisarEscalonamento Boolean      @default(false) @map("avisar_escalonamento")
  numeroAviso         String?      @map("numero_aviso") // destino do aviso; null = o próprio número
  criadoEm           DateTime      @default(now()) @map("criado_em")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  missoes      Missao[]
  campanhas    Campanha[]
  agendamentos Agendamento[]

  @@unique([instanciaEvolution]) // webhook resolve o número pela instância → tem que ser único (anti-vazamento cross-tenant)
  @@index([tenantId])
  @@map("numeros_whatsapp")
}

// ─── Contatos / leads ────────────────────────────────────────
model Contato {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  telefone String
  nome     String?
  dados    Json? // dados livres do lead
  memoria  Json? // memória INDIVIDUAL: fatos consolidados do contato (persistem entre missões)
  // DNA do contato (JSON): conhecimento estruturado SOBRE A PESSOA (perfil/comunicação/
  // histórico/observações). Personalização, NÃO fonte de fato autorizado. Ver features/contatos/
  // contato.dna. Defaults-first + orçamento de contexto. [parceiro Item 5, monta sobre o #4]
  dna      Json?
  origem   String? // manual | indicacao | lista
  optOut      Boolean   @default(false) @map("opt_out") // pediu pra não receber → bloqueia envios
  optOutEm    DateTime? @map("opt_out_em")
  optInEm     DateTime? @map("opt_in_em") // registro de consentimento (LGPD)
  optInOrigem String?   @map("opt_in_origem") // manual | lote | inbound
  criadoEm DateTime @default(now()) @map("criado_em")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  missoes      Missao[]
  mensagens    Mensagem[]
  fila         FilaEnvio[]
  agendamentos Agendamento[]
  tags         ContatoTag[]

  @@unique([tenantId, telefone])
  @@index([tenantId])
  @@map("contatos")
}

// Tag (rótulo) de contato — segmentação do CRM. Permite disparar missão/campanha
// para "todos da tag X" (ex.: costa-doce, lead-quente, inadimplente).
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String
  cor       String? // hex opcional p/ o chip no painel
  // Descrição = CONHECIMENTO pra IA: injetada no contexto de toda conversa com um contato
  // que tenha esta tag (camada complementar, não substitui persona/informações). [parceiro Item 1]
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  contatos ContatoTag[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("tags")
}

// N:N entre Contato e Tag.
model ContatoTag {
  contatoId String @map("contato_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  contato Contato @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contatoId, tagId])
  @@index([tagId])
  @@map("contato_tags")
}

// Missão programada: dispara sozinha na data (uma vez ou mensal, por contato).
// No dia, o agendador cria uma Missão e inicia (IA conduz) ou enfileira um texto fixo.
model Agendamento {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  contatoId String @map("contato_id") @db.Uuid
  numeroId  String @map("numero_id") @db.Uuid

  // definição da missão criada no disparo
  tipo              String  @default("cobrar")
  modo              String  @default("auto")
  objetivo          String
  contexto          String?
  criterioConclusao String? @map("criterio_conclusao")
  tom               String?
  informacoes       String?
  midiaIds          String[] @default([]) @map("midia_ids") @db.Uuid // anexos do disparo (ex.: boleto); IA oferece / entrega fixa manda junto

  // agendamento — recorrencia: uma_vez | diario | dias_uteis | fim_de_semana | semanal |
  // a_cada_dias | a_cada_semanas | mensal | a_cada_meses | anual  [parceiro Item 3]
  recorrencia  String    @default("mensal")
  diaDoMes     Int?      @map("dia_do_mes") // 1-31 (mensal/a_cada_meses); dia curto → último dia do mês
  dataUnica    DateTime? @map("data_unica") // uma_vez (a data) | anual (dia+mês de referência)
  intervalo    Int?      // a_cada_dias/semanas/meses: o "X" (a cada X)
  diasSemana   String?   @map("dias_semana") // semanal/a_cada_semanas: CSV de 0-6 (0=domingo), ex.: "1,3,5"
  horario      String?   // HH:mm — só dispara a partir desse horário no dia (opcional)
  dataInicio   DateTime? @map("data_inicio") // âncora dos ciclos "a cada X" + não dispara antes
  dataFim      DateTime? @map("data_fim") // não dispara depois (opcional)
  maxExecucoes Int?      @map("max_execucoes") // para automaticamente após N disparos (opcional)
  execucoes    Int       @default(0) // contador de disparos efetivados
  entrega      String    @default("ia") // 'ia' (conduz) | 'fixa' (só envia o texto)
  mensagemFixa String?   @map("mensagem_fixa")
  rotulo       String? // agrupador opcional (ex.: "Mensalidade")

  ativo           Boolean   @default(true)
  pularCicloRef   String?   @map("pular_ciclo_ref") // ex.: "2026-07" → pula esse ciclo (pago)
  ultimoCicloRef  String?   @map("ultimo_ciclo_ref") // idempotência: último ciclo disparado
  ultimoDisparoEm DateTime? @map("ultimo_disparo_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  contato Contato        @relation(fields: [contatoId], references: [id])
  numero  NumeroWhatsapp @relation(fields: [numeroId], references: [id])

  @@index([tenantId])
  @@index([ativo])
  @@map("agendamentos")
}

// ─── Templates de missão (reutilizáveis = "botão") ───────────
model MissaoTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  nome              String
  objetivo          String
  personaPrompt     String   @map("persona_prompt")
  tom               String?
  criterioConclusao String?  @map("criterio_conclusao")
  categorias        Json? // categorias de saída
  guardrails        String?
  criadoEm          DateTime @default(now()) @map("criado_em")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  missoes Missao[]

  @@index([tenantId])
  @@map("missao_templates")
}

// ─── Missões (instância viva; carrega a memória) ─────────────
model Missao {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  contatoId          String       @map("contato_id") @db.Uuid
  templateId         String?      @map("template_id") @db.Uuid
  campanhaId         String?      @map("campanha_id") @db.Uuid // agrupa missões de uma campanha
  numeroId           String       @map("numero_id") @db.Uuid
  tipo               String       @default("vender") // vender|qualificar|orcar|cobrar|suporte|outro
  objetivo           String
  contexto           String?
  criterioConclusao  String?      @map("criterio_conclusao") // quando a missão está cumprida
  tom                String? // humor/estilo da conversa (ex.: "amigável e informal")
  informacoes        String? // base de fatos autorizados que a IA PODE afirmar (preço, prazo, condições)
  midiaIds           String[]     @default([]) @map("midia_ids") @db.Uuid // biblioteca curada DESTA missão; vazio → toda a biblioteca do tenant
  dna                Json? // camada de DNA DESTA missão (#9 Fase C): {categoria:{modo,texto}}; vence a campanha e o tenant
  estilo             Json? // perfil de conversa DESTA missão (formalidade/emoji/bolhas…); null → herda do tenant
  estado             EstadoMissao @default(configurada)
  modo               String       @default("auto") // auto = IA envia sozinha · copilot = rascunha e aguarda aprovação
  rascunho           String? // resposta da IA aguardando aprovação humana (modo copilot)
  iaPausada          Boolean      @default(false) @map("ia_pausada") // humano no controle → a IA não responde
  motivoEscala       String?      @map("motivo_escala") // por que foi escalada (mostrado no inbox)
  categoriaResultado String?      @map("categoria_resultado")
  resultado          String? // desfecho da missão ao concluir (ex.: "reunião agendada quinta 15h")
  resumo             String? // resumo rolante (memória)
  fatos              Json? // fatos extraídos (memória)
  tokensEntrada      Int          @default(0) @map("tokens_entrada") // instrumentação de custo (acumulado; só super-admin vê)
  tokensSaida        Int          @default(0) @map("tokens_saida")
  iniciadaEm         DateTime?    @map("iniciada_em")
  concluidaEm        DateTime?    @map("concluida_em")
  criadoEm           DateTime     @default(now()) @map("criado_em")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  contato   Contato         @relation(fields: [contatoId], references: [id])
  template  MissaoTemplate? @relation(fields: [templateId], references: [id])
  campanha  Campanha?       @relation(fields: [campanhaId], references: [id])
  numero    NumeroWhatsapp  @relation(fields: [numeroId], references: [id])
  mensagens Mensagem[]
  fila      FilaEnvio[]
  eventos   Evento[]

  @@index([tenantId, estado])
  @@index([campanhaId])
  @@map("missoes")
}

// ─── Campanhas (a MESMA missão disparada/agrupada p/ vários contatos) ──
model Campanha {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  numeroId          String   @map("numero_id") @db.Uuid
  nome              String
  tipo              String   @default("vender")
  modo              String   @default("auto") // auto | copilot (default das missões da campanha)
  objetivo          String
  contexto          String?
  criterioConclusao String?  @map("criterio_conclusao")
  tom               String?
  informacoes       String?
  midiaIds          String[] @default([]) @map("midia_ids") @db.Uuid // biblioteca curada da campanha (herdada por cada missão dela)
  dna               Json? // camada de DNA da campanha (#9 Fase B): {categoria: {modo, texto}} sobrescreve o tenant
  estilo            Json? // perfil de conversa da campanha (herdado por cada missão dela)
  criadoEm          DateTime @default(now()) @map("criado_em")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  numero  NumeroWhatsapp @relation(fields: [numeroId], references: [id])
  missoes Missao[]

  @@index([tenantId])
  @@map("campanhas")
}

// ─── Mensagens (histórico da conversa) ───────────────────────
model Mensagem {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  missaoId      String?      @map("missao_id") @db.Uuid
  contatoId     String       @map("contato_id") @db.Uuid
  direcao       Direcao
  conteudo      String
  statusEnvio   StatusEnvio? @map("status_envio")
  providerMsgId String?      @map("provider_msg_id")
  criadaEm      DateTime     @default(now()) @map("criada_em")
  enviadaEm     DateTime?    @map("enviada_em")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  missao  Missao? @relation(fields: [missaoId], references: [id])
  contato Contato @relation(fields: [contatoId], references: [id])

  @@unique([tenantId, providerMsgId]) // idempotência: não grava a mesma mensagem 2× (NULLs são distintos)
  @@index([missaoId, criadaEm])
  @@index([tenantId, criadaEm]) // monitoramento ao vivo (§8.10): msgs de hoje / última por tenant sem full-scan
  @@map("mensagens")
}

// ─── Fila de envio (o coração anti-bloqueio) ─────────────────
model FilaEnvio {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  missaoId     String      @map("missao_id") @db.Uuid
  contatoId    String      @map("contato_id") @db.Uuid
  payload      Json
  agendadoPara DateTime    @map("agendado_para")
  tentativas   Int         @default(0)
  status       StatusEnvio @default(pendente)
  criadoEm     DateTime    @default(now()) @map("criado_em")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  missao  Missao  @relation(fields: [missaoId], references: [id])
  contato Contato @relation(fields: [contatoId], references: [id])

  @@index([status, agendadoPara])
  @@map("fila_envio")
}

// ─── Eventos (auditoria / timeline) ──────────────────────────
model Evento {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  missaoId String?  @map("missao_id") @db.Uuid
  tipo     String
  dados    Json?
  criadoEm DateTime @default(now()) @map("criado_em")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  missao Missao? @relation(fields: [missaoId], references: [id])

  @@index([tenantId, criadoEm])
  @@map("eventos")
}
