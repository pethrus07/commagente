# Variáveis lidas pelo docker compose (copie para infra/.env e troque os valores).
# Sem este arquivo, o compose usa os defaults de desenvolvimento local.
# Atenção: o Postgres só aplica a senha na PRIMEIRA criação do volume. Trocar aqui depois
# não muda a senha de um banco que já existe (e quebra a conexão se não bater).
# Em produção, defina valores fortes e use o mesmo POSTGRES_PASSWORD no DATABASE_URL de apps/api/.env.

# Senha do Postgres da aplicação (docker-compose.yml e docker-compose.demo.yml)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Senha do Postgres próprio da Evolution API (só no docker-compose.yml completo)
EVOLUTION_DB_PASSWORD=troque-por-outra-senha-forte

# Chave da Evolution API (igual a EVOLUTION_API_KEY de apps/api/.env)
EVOLUTION_API_KEY=troque-por-uma-chave-forte
